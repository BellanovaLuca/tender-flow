# Chiave API Google Gemini (obbligatoria). Mai committarla: .env è in .gitignore.
GEMINI_API_KEY=
# Modello Gemini usato da tutti gli agenti.
GEMINI_MODEL=gemini-2.5-flash
# Timeout per singola chiamata LLM, in millisecondi.
GEMINI_TIMEOUT_MS=120000
# Tentativi massimi per chiamata LLM su errori transitori (429/5xx), con backoff esponenziale + jitter.
GEMINI_MAX_ATTEMPTS=4
# Listino Gemini in USD per 1M token, usato solo per stimare il costo di ogni run.
GEMINI_PRICE_INPUT_PER_M=0.30
GEMINI_PRICE_OUTPUT_PER_M=2.50
# Cartella con storico, template aziendale e bando di esempio.
KNOWLEDGE_BASE_DIR=../docs
# Bando di esempio avviabile dal pulsante "Usa bando di esempio" (opzionale).
SAMPLE_TENDER_DIR=../docs/Capitolato target
# Cartella dove vengono salvati upload, cache di estrazione e documenti generati.
DATA_DIR=./data
# Nome dell'azienda che risponde al bando (usato nei prompt).
COMPANY_NAME=Esempio Servizi S.p.A.
# Sezioni elaborate in parallelo (attenzione ai rate-limit del piano Gemini).
SECTION_CONCURRENCY=3
# Revisioni massime per sezione dopo un esito negativo del validatore.
MAX_SECTION_REVISIONS=1
# Giri di correzione delle incoerenze tra sezioni dopo l'Offer Validator; il residuo va all'operatore.
MAX_DOCUMENT_REVISIONS=1
# Origini ammesse per CORS (lista JSON).
CORS_ORIGINS=["http://localhost:5173"]
